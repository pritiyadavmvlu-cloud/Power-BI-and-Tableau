      <aliases enabled='yes' />
      <column caption='Physics_Clean ' datatype='real' name='[Calculation_1222146216759296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Physics]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Attendance_Clean ' datatype='real' name='[Calculation_1222146216853505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(TRIM(REPLACE(STR([Attendance]), &apos;%&apos;, &apos;&apos;)))' />
      </column>
      <column caption='Math_Clean ' datatype='integer' name='[Calculation_1222146216988674]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Math], 0)' />
      </column>
      <column caption='Chemistry_Clean ' datatype='integer' name='[Calculation_1222146217086979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Chemistry], 0)' />
      </column>
      <column caption='Clean_Score' datatype='real' name='[Calculation_1222146217848836]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL(FLOAT(REPLACE(STR([Pivot Field Values]), &apos;%&apos;, &apos;&apos;)), 0)' />
      </column>
      <column caption='Semester' datatype='string' name='[Calculation_1222146218549253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;Sem1&quot;) THEN &quot;Semester 1&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;Sem2&quot;) THEN &quot;Semester 2&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Total_Score' datatype='real' name='[Calculation_1222146218926086]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1222146216988674]+[Calculation_1222146217086979]+[Calculation_1222146216759296]+&#13;&#10;[Programming]' />
      </column>
      <column caption='Overall_Percentage' datatype='real' default-format='p0.0%' name='[Calculation_1222146219507719]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1222146218926086] / 400.0' />
      </column>
      <column caption='Performance_Band ' datatype='string' name='[Calculation_1222146220093448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1222146219507719] &gt;= 0.85 THEN &quot;Distinction&quot; &#13;&#10;ELSEIF [Calculation_1222146219507719] &gt;= 0.75 THEN &quot;First Class&quot; &#13;&#10;ELSEIF [Calculation_1222146219507719] &gt;= 0.60 THEN &quot;Second Class&quot; &#13;&#10;ELSE &quot;Needs Academic Support&quot;  &#13;&#10;END' />
      </column>
      <column caption='Attendance_Status' datatype='string' name='[Calculation_1222146220507145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1222146216853505] &gt;= 75 &#13;&#10;THEN &quot;Eligible (Good Standing)&quot; &#13;&#10;ELSE &quot;Shortage Warning (&lt;75%)&quot; &#13;&#10;END' />
      </column>
      <column caption='Dept_Average_Percentage_LOD' datatype='real' default-format='p0.0%' name='[Calculation_1222146224635914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Dept_Info] : AVG([Calculation_1222146219507719]) }' />
      </column>
      <column caption='Student_Overall_Career_Average' datatype='real' name='[Calculation_1222146225074187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Student_ID] : AVG([Calculation_1222146219507719]) }' />
      </column>
      <column caption='Variance_From_Dept_Average' datatype='real' name='[Calculation_1222146225287180]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1222146219507719] - [Calculation_1222146224635914]' />
      </column>
      <column caption='Benchmark_Status ' datatype='string' name='[Calculation_1222146225487885]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1222146225287180] &gt;= 0 THEN &quot;Above Department &#13;&#10;Benchmark&quot;  &#13;&#10;ELSE &quot;Below Department Benchmark&quot;  &#13;&#10;END' />
      </column>
      <column caption='Full_Name_Clean ' datatype='string' name='[Calculation_1222146229006350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER(LEFT(TRIM([Full_Name]), 1)) +  &#13;&#10;LOWER(MID(TRIM([Full_Name]), 2, FIND(TRIM([Full_Name]), &quot; &quot;) -  1)) +  &#13;&#10;&quot; &quot; +  &#13;&#10;UPPER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 1,  1)) +  &#13;&#10;LOWER(MID(TRIM([Full_Name]), FIND(TRIM([Full_Name]), &quot; &quot;) + 2,  LEN(TRIM([Full_Name]))))' />
      </column>
      <column caption=' First_Name ' datatype='string' name='[Calculation_1222146229370895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(SPLIT([Full_Name], &quot; &quot;, 1))' />
      </column>
      <column caption='Last_Name ' datatype='string' name='[Calculation_1222146229608464]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM(SPLIT([Full_Name], &quot; &quot;, -1))' />
      </column>
      <column caption='Dept_Branch ' datatype='string' name='[Calculation_1222146229800977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Dept_Info], &quot;-&quot;, 1)' />
      </column>
      <column caption='Section_ID ' datatype='string' name='[Calculation_1222146229956626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='SPLIT([Dept_Info], &quot;-&quot;, 2)' />
      </column>
      <column caption='Student_Display_Label' datatype='string' name='[Calculation_1222146230243347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Student_ID]+&quot;-&quot;+[Calculation_1222146229006350]+&quot;(&quot;+[Calculation_1222146229800977]+&quot;)&quot;' />
      </column>
